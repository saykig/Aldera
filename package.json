{
  "name": "aldera",
  "version": "0.1.0",
  "description": "An experimental interoperability layer for research data",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "aldera": "./dist/bin/aldera.js"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "node --import tsx bin/aldera.ts validate",
    "aldera": "node --import tsx bin/aldera.ts",
    "stage3a:build-bundles": "node --import tsx scripts/build-stage3a-bundles.ts",
    "stage3a:review": "node --import tsx scripts/render-stage3a-review.ts",
    "stage3a:human-review": "node --import tsx scripts/render-stage3a-human-review.ts",
    "stage3a:verify-sources": "node --import tsx scripts/verify-stage3a-sources.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
