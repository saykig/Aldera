{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aldera.dev/schema/mapping-bundle/0.1.0",
  "title": "Aldera mapping assertion bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mapping_version", "comparison", "mappings"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "mapping_version": { "type": "string", "minLength": 1 },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_dataset", "target_dataset"],
      "properties": {
        "source_dataset": { "const": "ucdp" },
        "target_dataset": { "const": "acled" }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mapping_version", "source", "target", "relation", "rationale", "meaning_preserved", "meaning_lost", "provenance"],
        "properties": {
          "id": { "type": "string", "pattern": "^map:" },
          "mapping_version": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/ref" },
          "target": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
          "relation": {
            "enum": ["aldera:close", "aldera:related", "aldera:incompatible", "aldera:unmapped"]
          },
          "rationale": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "place": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "temporal": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string", "format": "date" },
                  "to": { "type": "string", "format": "date" }
                }
              },
              "fields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "uncertainty": { "type": "string", "minLength": 1 },
          "meaning_preserved": { "$ref": "#/$defs/nonEmptyStrings" },
          "meaning_lost": { "$ref": "#/$defs/nonEmptyStrings" },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asserted_by", "asserted_at", "evidence", "method"],
            "properties": {
              "asserted_by": { "type": "string", "minLength": 1 },
              "asserted_at": { "type": "string", "format": "date-time" },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/ref" }
              },
              "method": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "pattern": "^(ucdp|acled):[^:]+$" },
    "nonEmptyStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
