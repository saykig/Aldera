{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aldera.dev/schema/relationship-assertion-bundle/0.1.0",
  "title": "Aldera real-data relationship-assertion bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assertion_bundle_version",
    "bundle_sha256",
    "relationship_authority",
    "comparison",
    "benchmark_provenance",
    "native_source_sets",
    "assertions"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "assertion_bundle_version": { "type": "string", "minLength": 1 },
    "bundle_sha256": { "$ref": "#/$defs/hash" },
    "relationship_authority": { "const": true },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_collection", "target_collection"],
      "properties": {
        "source_collection": { "const": "icbe" },
        "target_collection": { "const": "ucdp" }
      }
    },
    "benchmark_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "review_date"],
      "properties": {
        "path": { "const": "fixtures/real/icbe-ucdp-stage3a/human-review-benchmark.json" },
        "sha256": { "$ref": "#/$defs/hash" },
        "review_date": { "type": "string", "format": "date" }
      }
    },
    "native_source_sets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nativeSourceSet" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nativeSourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_directory", "bundles"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "relative_directory": { "type": "string", "minLength": 1 },
        "bundles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["icbe", "ucdp"],
          "properties": {
            "icbe": { "$ref": "#/$defs/nativeBundle" },
            "ucdp": { "$ref": "#/$defs/nativeBundle" }
          }
        }
      }
    },
    "nativeBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "review_item",
        "source_ref",
        "target_ref",
        "dimensions"
      ],
      "properties": {
        "kind": { "const": "relationship_assertion" },
        "id": { "type": "string", "pattern": "^relationship:icbe-ucdp:[0-9]{4}$" },
        "review_item": { "type": "integer", "minimum": 1 },
        "source_ref": { "type": "string", "pattern": "^icbe:.+" },
        "target_ref": { "type": "string", "pattern": "^ucdp:.+" },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "relatedness", "scope", "equivalence_safety"],
          "properties": {
            "identity": { "enum": ["same", "not_same", "uncertain"] },
            "relatedness": { "enum": ["related", "not_related", "uncertain"] },
            "scope": {
              "description": "no_broader_narrower_asserted means only that neither endpoint was judged broader; it does not assert equal scope, equivalent granularity, overlap, or non-overlap.",
              "enum": [
                "source_broader",
                "target_broader",
                "no_broader_narrower_asserted",
                "uncertain"
              ]
            },
            "equivalence_safety": {
              "description": "Occurrence-level alignment only. safe_as_equivalent does not make native fields, definitions, measurements, values, or records interchangeable.",
              "enum": ["safe_as_equivalent", "unsafe_as_equivalent", "uncertain"]
            }
          }
        },
        "human_note": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "meaning_preserved": { "$ref": "#/$defs/nonEmptyStrings" },
        "meaning_lost": { "$ref": "#/$defs/nonEmptyStrings" },
        "uncertainty_note": { "type": "string", "minLength": 1 }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
