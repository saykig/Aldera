{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aldera.dev/schema/source-bundle/0.1.0",
  "title": "Aldera native source bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "dataset_version", "fixture_notice", "records"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "dataset": { "enum": ["ucdp", "acled"] },
    "dataset_version": { "type": "string", "minLength": 1 },
    "fixture_notice": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "native_id", "native_sha256", "native"],
        "properties": {
          "ref": { "type": "string", "pattern": "^(ucdp|acled):[^:]+$" },
          "native_id": { "type": "string", "minLength": 1 },
          "native_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "native": { "type": "object" }
        }
      }
    }
  }
}
